# Host filesystem ownership for bind-mounted files.
# Set these to the Linux user/group that should own ./data and ./config on the host.
PUID=1000
PGID=1000

# Container timezone used by logs and scheduled save/backup timestamps.
TZ=America/Los_Angeles

# Host paths that will persist server files and optional gameplay config files.
HOST_DATA_DIR=./data
HOST_CONFIG_DIR=./config

# Container name and published image tag to pull.
SOULMASK_CONTAINER_NAME=soulmask
SOULMASK_IMAGE=acekorneya/soul_server
SOULMASK_TAG=latest
SOULMASK_RESTART_POLICY=unless-stopped

# Internal server ports used by Soulmask inside the container.
SOULMASK_GAME_PORT=8777
SOULMASK_QUERY_PORT=27015
SOULMASK_ECHO_PORT=18888
SOULMASK_RCON_PORT=19000

# Host ports published by Docker.
# Change the left-side published ports if these ports are already in use on the host.
SOULMASK_PUBLISHED_GAME_PORT=8777
SOULMASK_PUBLISHED_QUERY_PORT=27015
SOULMASK_PUBLISHED_RCON_PORT=19000

# Update behavior on container start.
# AUTO_UPDATE=true downloads or updates the dedicated server automatically.
# VALIDATE_ON_UPDATE=true runs Steam file validation, which is slower but can repair bad installs.
AUTO_UPDATE=true
VALIDATE_ON_UPDATE=false

# Visible server name shown in the server browser.
SOULMASK_SERVER_NAME=POK Soulmask Server

# Leave SERVER_PASSWORD empty for a public server.
SOULMASK_SERVER_PASSWORD=

# Admin password for in-game admin access. Change this before exposing the server.
SOULMASK_ADMIN_PASSWORD=AdminChangeMePlease!

# Startup map / level. Default is the base map.
SOULMASK_LEVEL_NAME=Level01_Main

# Valid values: pve or pvp.
SOULMASK_GAME_MODE=pve

# Maximum connected players.
SOULMASK_MAX_PLAYERS=50

# Local listen address inside the container. 0.0.0.0 is correct for normal Docker usage.
SOULMASK_LISTEN_ADDRESS=0.0.0.0

# Save interval keeps world state in memory synchronized.
SOULMASK_SAVE_INTERVAL_SECONDS=600

# Backup interval writes the world data out to disk.
SOULMASK_BACKUP_INTERVAL_SECONDS=900

# Create a startup backup before the server begins accepting players.
SOULMASK_INIT_BACKUP=false

# Optional periodic world.db snapshot interval in minutes. Leave blank to disable extra snapshot backups.
SOULMASK_BACKUP_INTERVAL_MINUTES=

# RCON settings. Leave password blank to keep RCON disabled.
SOULMASK_RCON_ADDRESS=
SOULMASK_RCON_PASSWORD=

# Comma-separated Steam Workshop mod IDs.
SOULMASK_MOD_IDS=

# Optional advanced server identity and cluster settings.
# SOULMASK_SERVER_ID must be numeric when set.
SOULMASK_SERVER_ID=
SOULMASK_CLUSTER_MAIN_SERVER_PORT=
SOULMASK_CLUSTER_CLIENT_SERVER_CONNECT=

# Optional gameplay template name. When set, the server uses GameXishu_<template>.json.
SOULMASK_COEF_TEMPLATE=

# Optional advanced gameplay limits and permission mask.
SOULMASK_TRIBE_MAX_MEMBERS=
SOULMASK_PERMISSION_MASK=

# Optional Steam beta branch settings.
SOULMASK_STEAM_BRANCH=
SOULMASK_STEAM_BETA_PASSWORD=

# Enable verbose game logs in the container output.
SOULMASK_LOG_ENABLED=true

# Online mode for the dedicated server. Steam is the default.
SOULMASK_ONLINE_MODE=Steam

# Extra raw command-line flags appended to WSServer.sh. Use sparingly.
SOULMASK_EXTRA_ARGS=
