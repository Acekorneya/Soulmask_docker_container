# Host filesystem ownership for bind-mounted files.
# Set these to the Linux user/group that should own ./shared, ./config, and ./instances.
PUID=1000
PGID=1000

# Container timezone used by logs and scheduled save/backup timestamps.
TZ=America/Los_Angeles

# Host paths used by the published compose files.
# ./shared stores the single SteamCMD tree and the single shared game install.
# ./instances/server_1 and ./instances/server_2 store per-instance runtime data.
# ./config stores per-instance config folders plus the shared GameXishu.json.example template.
# The repo ships these folders. Keep them owned by the same Linux user/group as
# PUID and PGID so the non-root container can write to them.
HOST_SHARED_DIR=./shared
HOST_CONFIG_ROOT_DIR=./config
HOST_INSTANCE_DIR=./instances/server_1
HOST_SERVER_2_INSTANCE_DIR=./instances/server_2

# Container names and published image tag to pull.
SOULMASK_CONTAINER_NAME=soulmask
SOULMASK_SERVER_2_CONTAINER_NAME=soulmask-server-2
SOULMASK_IMAGE=acekorneya/soul_server
SOULMASK_TAG=latest
SOULMASK_RESTART_POLICY=unless-stopped

# Shared Docker network used for clustering.
# Server 1 creates this network and is reachable by server 2 as "soulmask-main".
# If Docker says the pool overlaps with another network, change SOULMASK_CLUSTER_SUBNET
# to any unused private /24 such as 172.31.240.0/24 or 10.231.0.0/24.
SOULMASK_CLUSTER_NETWORK_NAME=soulmask-cluster
SOULMASK_CLUSTER_SUBNET=172.31.240.0/24

# Server 1 internal ports used by Soulmask inside the container.
# SOULMASK_ECHO_PORT is the maintenance/admin port used by soulmask-maint and by graceful shutdown.
SOULMASK_GAME_PORT=8777
SOULMASK_QUERY_PORT=27015
SOULMASK_ECHO_PORT=18888

# Server 1 host ports published by Docker.
# The maintenance/admin port stays internal to the container and is accessed with docker exec.
SOULMASK_PUBLISHED_GAME_PORT=8777
SOULMASK_PUBLISHED_QUERY_PORT=27015

# Server 2 host ports published by Docker.
# Server 2 still listens on the default internal Soulmask ports inside its own container.
SOULMASK_SERVER_2_PUBLISHED_GAME_PORT=8778
SOULMASK_SERVER_2_PUBLISHED_QUERY_PORT=27016

# Cluster setup.
# Set ENABLE_CLUSTER=true only when you are running a PvE two-map cluster.
# docker-compose.yaml becomes the main cluster server automatically.
# docker-compose_server_2.yaml becomes the client cluster server automatically.
# The internal cluster link port is fixed inside the compose files.
# Users do not need to set it and do not need to port-forward it.
ENABLE_CLUSTER=false

# Update behavior on container start.
# Server 1 usually keeps AUTO_UPDATE=true.
# Server 2 defaults AUTO_UPDATE=false inside server_2.env so it reuses the shared install.
AUTO_UPDATE=true
VALIDATE_ON_UPDATE=false

# Shared password settings for the cluster.
# Keep the same server password on both nodes for the smoothest map transfers.
SOULMASK_SERVER_PASSWORD=
SOULMASK_ADMIN_PASSWORD=AdminChangeMePlease!

# Server 1 visible name and map.
# For a fresh cluster, server 1 can be either Level01_Main or DLC_Level01_Main.
SOULMASK_SERVER_NAME=POK Soulmask Server
SOULMASK_LEVEL_NAME=Level01_Main

# Clustered cross-map play is currently supported only for PvE.
SOULMASK_GAME_MODE=pve

# Shared gameplay defaults used by both nodes unless server_2.env overrides them.
SOULMASK_MAX_PLAYERS=50
SOULMASK_LISTEN_ADDRESS=0.0.0.0
SOULMASK_SAVE_INTERVAL_SECONDS=600
SOULMASK_BACKUP_INTERVAL_SECONDS=900
SOULMASK_INIT_BACKUP=false
SOULMASK_BACKUP_INTERVAL_MINUTES=

# Shared optional gameplay and startup settings.
SOULMASK_MOD_IDS=
SOULMASK_COEF_TEMPLATE=
SOULMASK_TRIBE_MAX_MEMBERS=
SOULMASK_PERMISSION_MASK=
SOULMASK_STEAM_BRANCH=
SOULMASK_STEAM_BETA_PASSWORD=
SOULMASK_LOG_ENABLED=true
SOULMASK_ONLINE_MODE=Steam
SOULMASK_EXTRA_ARGS=

# Graceful shutdown behavior.
# On container stop, the entrypoint sends `saveworld 1` and then `quit <seconds>`
# through Soulmask's maintenance port before falling back to process signals.
SOULMASK_SHUTDOWN_DELAY_SECONDS=30
SOULMASK_SAVEWORLD_WAIT_SECONDS=30
