# Server 2 is the second map in the cluster.
# Start server 1 first with:
# docker compose up -d
# Then start server 2 with:
# docker compose -f docker-compose_server_2.yaml up -d
# Cluster mode is enabled in .env with ENABLE_CLUSTER=true.
# No extra cluster port or cluster address needs to be set here when both
# servers run on the same Docker host. Server 2 uses soulmask-main:29000.

# Visible server name for the second map.
SOULMASK_SERVER_NAME=POK Soulmask Server 2

# Use the opposite map from server 1.
# If server 1 is Level01_Main, use DLC_Level01_Main here.
# If server 1 is DLC_Level01_Main, use Level01_Main here.
SOULMASK_LEVEL_NAME=DLC_Level01_Main

# Server 2 should reuse the shared install instead of updating it directly.
AUTO_UPDATE=false

# Optional server-2-only overrides.
# Any multiplier set here overrides the shared value from .env for server 2 only.
# These are written into ./instances/server_2/saved/GameplaySettings/GameXishu.json before launch.
# SOULMASK_EXP_MULTIPLIER=3
# SOULMASK_YIELD_MULTIPLIER=3
# SOULMASK_TAMING_SPEED_MULTIPLIER=1.5
# SOULMASK_HATCHING_SPEED_MULTIPLIER=1.5
# SOULMASK_ANIMAL_GROWTH_SPEED_MULTIPLIER=1.5
# SOULMASK_CROP_GROWTH_SPEED_MULTIPLIER=1.5
# SOULMASK_TRAINING_GROUND_EXP_MULTIPLIER=3
# SOULMASK_MAX_LOAD_MULTIPLIER=1
# SOULMASK_INVENTORY_SLOTS_MULTIPLIER=1
# Leave these unset to keep the shared `.env` values and shipped GameXishu defaults.
# SOULMASK_SHIP_BUILD_RANGE_LIMIT_ENABLED=1
# SOULMASK_SHIP_BUILDING_COUNT_LIMIT_ENABLED=0
# SOULMASK_SHIP_BUILDING_COUNT_MULTIPLIER=0.10000000149011612
# SOULMASK_PERSONAL_SHIP_LIMIT=2
# SOULMASK_TRIBE_SHIP_LIMIT=10
# SOULMASK_PERSONAL_SPECIFIC_SHIP_LIMIT=1
# SOULMASK_TRIBE_SPECIFIC_SHIP_LIMIT=2
# SOULMASK_CRAFTING_SPEED_MULTIPLIER=2
# SOULMASK_DURABILITY_CONSUMPTION_MULTIPLIER=0.75
# SOULMASK_BONFIRE_FUEL_CONSUMPTION_MULTIPLIER=0.75
# SOULMASK_PERSONAL_BONFIRE_LIMIT=6
# SOULMASK_TRIBE_BONFIRE_LIMIT=6
# SOULMASK_TRIBE_RECRUIT_LIMIT=75
# SOULMASK_PERSONAL_RECRUIT_BONUS_LEVEL_1=6
# SOULMASK_PERSONAL_RECRUIT_BONUS_LEVEL_2=10
# SOULMASK_PERSONAL_RECRUIT_BONUS_LEVEL_3=15
# SOULMASK_DEPLOYED_TRIBESMEN_LIMIT=3
# SOULMASK_BUILDING_DECAY_ENABLED=1
# SOULMASK_BUILDING_DECAY_MULTIPLIER=1
# SOULMASK_BUILDING_REPAIR_SPEED_MULTIPLIER=1
# SOULMASK_CRAFT_FROM_NEARBY_CHESTS_ENABLED=1
SOULMASK_COEF_TEMPLATE=
SOULMASK_EXTRA_ARGS=
