# Server 2 is the second map in the cluster.
# Start server 1 first with:
# docker compose up -d
# Then start server 2 with:
# docker compose -f docker-compose_server_2.yaml up -d
# Cluster mode is enabled in .env with ENABLE_CLUSTER=true.
# No extra cluster port or cluster address needs to be set here.

# Visible server name for the second map.
SOULMASK_SERVER_NAME=POK Soulmask Server 2

# Use the opposite map from server 1.
# If server 1 is Level01_Main, use DLC_Level01_Main here.
# If server 1 is DLC_Level01_Main, use Level01_Main here.
SOULMASK_LEVEL_NAME=DLC_Level01_Main

# Server 2 should reuse the shared install instead of updating it directly.
AUTO_UPDATE=false

# Optional server-2-only overrides.
# Any multiplier set here overrides the shared value from .env for server 2 only.
# These are written into ./instances/server_2/saved/GameplaySettings/GameXishu.json before launch.
# SOULMASK_EXP_MULTIPLIER=3
# SOULMASK_YIELD_MULTIPLIER=3
# SOULMASK_TAMING_SPEED_MULTIPLIER=1.5
# SOULMASK_HATCHING_SPEED_MULTIPLIER=1.5
# SOULMASK_ANIMAL_GROWTH_SPEED_MULTIPLIER=1.5
# SOULMASK_CROP_GROWTH_SPEED_MULTIPLIER=1.5
# SOULMASK_TRAINING_GROUND_EXP_MULTIPLIER=3
# SOULMASK_MAX_LOAD_MULTIPLIER=1
# SOULMASK_INVENTORY_SLOTS_MULTIPLIER=1
SOULMASK_COEF_TEMPLATE=
SOULMASK_EXTRA_ARGS=
