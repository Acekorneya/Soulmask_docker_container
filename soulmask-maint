#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
  cat <<'EOF'
Usage:
  soulmask-maint [options] [command...]

Options:
  -H, --host HOST         Target host. Default: 127.0.0.1
  -P, --port PORT         Target TCP port. Default: SOULMASK_ECHO_PORT or 18888
  -i, --interactive       Start an interactive session
  -t, --timeout SECONDS   Idle read timeout after each send. Default: 1.0
  -h, --help              Show this help text

Examples:
  soulmask-maint help
  soulmask-maint saveworld 1
  soulmask-maint quit 30
  soulmask-maint --interactive
EOF
}

die() {
  printf "soulmask-maint: %s\n" "$*" >&2
  exit 1
}

send_line() {
  printf '%s\r\n' "$1" >&3
}

drain_until_idle() {
  local timeout="$1"
  local line=""

  while IFS= read -r -t "$timeout" -u 3 line; do
    printf '%s\n' "$line"
  done
}

HOST="${SOULMASK_MAINT_HOST:-127.0.0.1}"
PORT="${SOULMASK_ECHO_PORT:-18888}"
IDLE_TIMEOUT="${SOULMASK_MAINT_IDLE_TIMEOUT:-1.0}"
INTERACTIVE=false

while (($#)); do
  case "$1" in
    -H|--host)
      (($# >= 2)) || die "Missing value for $1"
      HOST="$2"
      shift 2
      ;;
    -P|--port)
      (($# >= 2)) || die "Missing value for $1"
      PORT="$2"
      shift 2
      ;;
    -i|--interactive)
      INTERACTIVE=true
      shift
      ;;
    -t|--timeout)
      (($# >= 2)) || die "Missing value for $1"
      IDLE_TIMEOUT="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "Unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

if ! [[ "$PORT" =~ ^[0-9]+$ ]]; then
  die "Port must be numeric. Got: $PORT"
fi

exec 3<>"/dev/tcp/${HOST}/${PORT}" || die "Could not connect to ${HOST}:${PORT}"

sleep 0.2
drain_until_idle "$IDLE_TIMEOUT" || true

if $INTERACTIVE || (($# == 0)); then
  {
    local local_line=""
    while IFS= read -r -u 3 local_line; do
      printf '%s\n' "$local_line"
    done
  } &
  reader_pid=$!

  trap 'kill "$reader_pid" 2>/dev/null || true; exit 0' INT TERM

  while IFS= read -r stdin_line; do
    send_line "$stdin_line"
  done

  kill "$reader_pid" 2>/dev/null || true
  wait "$reader_pid" 2>/dev/null || true
  exit 0
fi

COMMAND="$*"
send_line "$COMMAND"
sleep 0.2
drain_until_idle "$IDLE_TIMEOUT" || true
